{# Receipt template for genalog's DocumentGenerator.

   genalog ships templates for prose -- text_block, columns, letter -- and none
   of them has a notion of columns measured in characters, which is what a till
   roll is. This template keeps genalog's contract (a Jinja2 template rendered
   through WeasyPrint, styled by variables passed in as **styles) and swaps the
   body for the rule-base grid, so a receipt can be generated by genalog on the
   same terms as by the other two backends.

   `content` is a list of cells, each already positioned on the grid by
   `rulebase.layout`; this file only decides what that looks like on paper. #}
<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="utf-8"/>
  <style>
    @page {
      size: {{ page_width }} {{ page_height }};
      margin: {{ page_margin }};
    }
    html, body {
      margin: 0;
      padding: 0;
      background: #ffffff;
      color: {{ ink }};
    }
    #sheet {
      position: relative;
      font-family: {{ font_family }};
      font-size: {{ font_size }};
      line-height: {{ line_height }};
      width: {{ sheet_width }};
      height: {{ sheet_height }};
      {% if hyphenate %}hyphens: auto;{% endif %}
    }
    #sheet span {
      position: absolute;
      white-space: pre;
      height: {{ line_height }};
      line-height: {{ line_height }};
    }
    #sheet i { font-style: normal; }
    /* Non-text primitives, behind the words: a printed rule is drawn by the
       press and the text sits in the cell it makes. Same (row, column) grid
       the spans use, so nothing here needs a second coordinate system. */
    #sheet .mark { position: absolute; }
    .accent { color: {{ accent }}; }
    #tint {
      position: absolute;
      top: 0; left: 0; right: 0; bottom: 0;
      background: {{ tint }};
      opacity: {{ tint_alpha }};
    }
  </style>
</head>
<body>
  <div id="sheet">
    {%- for mark in marks %}
    <div class="mark" style="left:{{ mark.left }}ch;top:{{ mark.top }};width:{{ mark.width }};height:{{ mark.height }};background:{{ mark.shade }}"></div>
    {%- endfor %}
    {%- for cell in content %}
    <span style="left:{{ cell.left }}ch;top:{{ cell.top }};width:{{ cell.width }}ch;text-align:{{ cell.align }}"{% if cell.accent %} class="accent"{% endif %}><i style="font-size:{{ cell.scale }}em{% if cell.bold %};font-weight:700{% endif %}">{{ cell.text }}</i></span>
    {%- endfor %}
    {%- if tint_alpha|float > 0 %}
    <div id="tint"></div>
    {%- endif %}
  </div>
</body>
</html>
