# ---------------------------------------------------------------- Python
__pycache__/
*.py[cod]
*.so
*.egg-info/
build/
dist/

# Virtual environments -- each generator has its own
.venv/
venv/
env/
generators/*/.venv/

# Tooling caches
.ruff_cache/
.pytest_cache/
.mypy_cache/
.coverage

# ------------------------------------------------------- Generated output
# Generators write beside themselves; none of it belongs in git.
outputs/
generators/*/outputs/
generators/*/output/
datasets/
*.jsonl
*.tar
*.parquet
*.lmdb

# Images are ignored by default, then let back in one directory at a time.
*.png
*.jpg
*.jpeg
*.webp
*.pdf
!generators/synthdog/docs/**/*.jpg     # figures in the generator's README
!generators/html-table/**/*.png        # figures the vendored code ships
!samples/**/*.jpg                      # the curated examples this repo shows
!samples/**/*.json

# Fonts, paper and backgrounds are not redistributable; supply them locally.
# See generators/synthdog/resources/README.md.
*.ttf
*.otf
*.ttc
generators/synthdog/resources/font/
generators/synthdog/resources/paper/
generators/synthdog/resources/background/

# Model checkpoints and training runs
checkpoints/
runs/
wandb/
*.ckpt
*.pt
*.pth
*.safetensors

# ---------------------------------------------------------- Editors / OS
.idea/
.vscode/
*.swp
*~
.ipynb_checkpoints/
.DS_Store
Thumbs.db

# Local overrides
.env
.env.*
!.env.example
