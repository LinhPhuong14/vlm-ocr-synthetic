# ---------------------------------------------------------------- Python
__pycache__/
*.py[cod]
*.so
*.egg-info/
build/
dist/

# Virtual environments -- each generator has its own
.venv/
venv/
env/
generators/*/.venv/

# Tooling caches
.ruff_cache/
.pytest_cache/
.mypy_cache/
.coverage

# ------------------------------------------------------- Generated output
# Generators write beside themselves; none of it belongs in git.
outputs/
generators/*/outputs/
generators/*/output/
datasets/
*.jsonl
*.tar
*.parquet
*.lmdb

# Images are ignored by default, then let back in one directory at a time.
*.png
*.jpg
*.jpeg
*.webp
*.pdf
# NB: git has no inline comments in .gitignore -- a trailing "# ..." is read
# as part of the pattern, which silently stops the negation matching anything.
# Keep every comment on its own line.
# Figures in the generator's README:
!generators/synthdog/docs/**/*.jpg
# The curated examples this repo shows:
!samples/**/*.jpg
!samples/**/*.json
# The figures README.md embeds, built by docs/figures/make_figures.py:
!docs/figures/*.jpg
# The paper every renderer composites onto, and the scenes it is photographed
# on -- generated or redistributable, and a clone cannot render without them:
!assets/textures/**/*.jpg
# Photographs of real sheets, laid over a finished page by `paper_overlay`:
!assets/overlays/*.jpg
# Seals and flourishes. PNG and not JPG because every one of them is mostly
# transparent -- an alpha channel is the whole point of an overlay -- and
# generated by tools/make_ornaments.py, so redistributable like the paper.
!assets/textures/ornament/*.png
# The reference sheets: the HTML source and the JPG anyone can look at are
# tracked; the PDF between them is a build artefact, regenerated by
# `make templates` in the second it takes WeasyPrint to lay one page out.
samples/invoice-templates/out/
# `data/` is output. A dataset is rebuilt from the rule-base, so nothing a run
# writes there is tracked -- only `data/README.md`, which says how to rebuild it.
# The few real renders the test suite cannot synthesise live in tests/fixtures/:
!tests/fixtures/**/*.jpg
!tests/fixtures/**/*.json

# Fonts you supply yourself are not redistributable; keep them out.
# `assets/fonts/` is the exception: everything in it is OFL, Apache-2.0 or
# Bitstream Vera, and without it a fresh clone cannot render at all. See
# assets/fonts/README.md.
*.ttf
*.otf
*.ttc
!assets/fonts/**/*.ttf
!assets/fonts/**/*.otf
generators/synthdog/resources/font/
generators/synthdog/resources/paper/
generators/synthdog/resources/background/

# Model checkpoints and training runs
checkpoints/
runs/
wandb/
*.ckpt
*.pt
*.pth
*.safetensors

# ---------------------------------------------------------- Editors / OS
.idea/
.vscode/
*.swp
*~
.ipynb_checkpoints/
.DS_Store
Thumbs.db

# Local overrides
.env
.env.*
!.env.example

# Everything a run writes under `data/`: the assembled dataset, `dataset.json`,
# the OCR proof, and the run's own working state -- shard directories with their
# DONE files, per-worker logs, the plan, the manifest and the timings. All of it
# is regenerated by the next run, and `.shards/` holds a second copy of every
# image (hard-linked on disk, but not in git).
data/*
!data/README.md
