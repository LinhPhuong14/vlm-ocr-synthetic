 đối với tất cả các yêu cầu, khiếu nại, nghĩa ", "quad": [[106.3, 1049.8], [1034.5, 1049.8], [1034.5, 1068.2], [106.3, 1068.2]]}, {"id": "p1-b42", "page_number": 1, "index_in_page": 42, "label": "Text", "bbox": {"x1": 106, "y1": 1072, "x2": 1010, "y2": 1091}, "content": "vụ nợ, tổn thất, chi phí phát sinh liên quan đến hay do việc Công ty thanh toán khoản tiền này cho Người được ủy", "kind": "note", "text": "vụ nợ, tổn thất, chi phí phát sinh liên quan đến hay do việc Công ty thanh toán khoản tiền này cho Người được ủy ", "quad": [[106.3, 1072.3], [1009.6, 1072.3], [1009.6, 1090.8], [106.3, 1090.8]]}, {"id": "p1-b43", "page_number": 1, "index_in_page": 43, "label": "Text", "bbox": {"x1": 106, "y1": 1095, "x2": 233, "y2": 1113}, "content": "quyền nêu trên.", "kind": "note", "text": "quyền nêu trên.", "quad": [[106.3, 1094.9], [232.8, 1094.9], [232.8, 1113.3], [106.3, 1113.3]]}, {"id": "p1-b44", "page_number": 1, "index_in_page": 44, "label": "Text", "bbox": {"x1": 85, "y1": 1126, "x2": 1017, "y2": 1144}, "content": "Giấy ủy quyền này chỉ có hiệu lực trong vòng ba (03) tháng kể từ ngày ký và có giá trị ràng buộc đối với những người", "kind": "note", "text": "Giấy ủy quyền này chỉ có hiệu lực trong vòng ba (03) tháng kể từ ngày ký và có giá trị ràng buộc đối với những người ", "quad": [[84.9, 1126.0], [1016.6, 1126.0], [1016.6, 1144.4], [84.9, 1144.4]]}, {"id": "p1-b45", "page_number": 1, "index_in_page": 45, "label": "Text", "bbox": {"x1": 85, "y1": 1148, "x2": 703, "y2": 1167}, "content": "đại diện của cá nhân tôi, những người thừa kế và/ hoặc quản lý di sản của tôi.", "kind": "note", "text": "đại diện của cá nhân tôi, những người thừa kế và/ hoặc quản lý di sản của tôi.", "quad": [[84.9, 1148.5], [703.2, 1148.5], [703.2, 1166.9], [84.9, 1166.9]]}, {"id": "p1-b46", "page_number": 1, "index_in_page": 46, "label": "Text", "bbox": {"x1": 82, "y1": 1198, "x2": 248, "y2": 1217}, "content": "Bên mua bảo hiểm", "kind": "sign.title", "text": "Bên mua bảo hiểm", "quad": [[82.