ác yêu cầu, khiếu nại, nghĩa ", "quad": [[100.8, 984.4], [980.3, 984.4], [980.3, 1001.9], [100.8, 1001.9]]}, {"id": "p1-b42", "page_number": 1, "index_in_page": 42, "label": "Text", "bbox": {"x1": 101, "y1": 1006, "x2": 957, "y2": 1023}, "content": "vụ nợ, tổn thất, chi phí phát sinh liên quan đến hay do việc Công ty thanh toán khoản tiền này cho Người được ủy", "kind": "note", "text": "vụ nợ, tổn thất, chi phí phát sinh liên quan đến hay do việc Công ty thanh toán khoản tiền này cho Người được ủy ", "quad": [[100.8, 1005.8], [956.6, 1005.8], [956.6, 1023.2], [100.8, 1023.2]]}, {"id": "p1-b43", "page_number": 1, "index_in_page": 43, "label": "Text", "bbox": {"x1": 101, "y1": 1027, "x2": 221, "y2": 1045}, "content": "quyền nêu trên.", "kind": "note", "text": "quyền nêu trên.", "quad": [[100.8, 1027.1], [220.6, 1027.1], [220.6, 1044.6], [100.8, 1044.6]]}, {"id": "p1-b44", "page_number": 1, "index_in_page": 44, "label": "Text", "bbox": {"x1": 80, "y1": 1057, "x2": 963, "y2": 1074}, "content": "Giấy ủy quyền này chỉ có hiệu lực trong vòng ba (03) tháng kể từ ngày ký và có giá trị ràng buộc đối với những người", "kind": "note", "text": "Giấy ủy quyền này chỉ có hiệu lực trong vòng ba (03) tháng kể từ ngày ký và có giá trị ràng buộc đối với những người ", "quad": [[80.5, 1056.6], [963.3, 1056.6], [963.3, 1074.0], [80.5, 1074.0]]}, {"id": "p1-b45", "page_number": 1, "index_in_page": 45, "label": "Text", "bbox": {"x1": 80, "y1": 1078, "x2": 666, "y2": 1095}, "content": "đại diện của cá nhân tôi, những người thừa kế và/ hoặc quản lý di sản của tôi.", "kind": "note", "text": "đại diện của cá nhân tôi, những người thừa kế và/ hoặc quản lý di sản của tôi.", "quad": [[80.5, 1077.9], [666.3, 1077.9], [666.3, 1095.4], [80.5, 1095.4]]}, {"id": "p1-b46", "page_number": 1, "index_in_page": 46, "label": "Text", "bbox": {"x1": 78, "y1": 1125, "x2": 235, "y2": 1142}, "content": "Bên mua bảo hiểm", "kind": "sign.title", "text": "Bên mua bảo hiểm", "quad": [[77.9, 1125.0], [235.3, 1125.0]