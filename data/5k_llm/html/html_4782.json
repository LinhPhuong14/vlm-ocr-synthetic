êu cầu, khiếu nại, nghĩa ", "quad": [[101.3, 989.9], [985.8, 989.9], [985.8, 1007.5], [101.3, 1007.5]]}, {"id": "p1-b42", "page_number": 1, "index_in_page": 42, "label": "Text", "bbox": {"x1": 101, "y1": 1011, "x2": 962, "y2": 1029}, "content": "vụ nợ, tổn thất, chi phí phát sinh liên quan đến hay do việc Công ty thanh toán khoản tiền này cho Người được ủy", "kind": "note", "text": "vụ nợ, tổn thất, chi phí phát sinh liên quan đến hay do việc Công ty thanh toán khoản tiền này cho Người được ủy ", "quad": [[101.3, 1011.4], [962.0, 1011.4], [962.0, 1029.0], [101.3, 1029.0]]}, {"id": "p1-b43", "page_number": 1, "index_in_page": 43, "label": "Text", "bbox": {"x1": 101, "y1": 1033, "x2": 222, "y2": 1050}, "content": "quyền nêu trên.", "kind": "note", "text": "quyền nêu trên.", "quad": [[101.3, 1032.9], [221.8, 1032.9], [221.8, 1050.4], [101.3, 1050.4]]}, {"id": "p1-b44", "page_number": 1, "index_in_page": 44, "label": "Text", "bbox": {"x1": 81, "y1": 1062, "x2": 969, "y2": 1080}, "content": "Giấy ủy quyền này chỉ có hiệu lực trong vòng ba (03) tháng kể từ ngày ký và có giá trị ràng buộc đối với những người", "kind": "note", "text": "Giấy ủy quyền này chỉ có hiệu lực trong vòng ba (03) tháng kể từ ngày ký và có giá trị ràng buộc đối với những người ", "quad": [[80.9, 1062.5], [968.7, 1062.5], [968.7, 1080.1], [80.9, 1080.1]]}, {"id": "p1-b45", "page_number": 1, "index_in_page": 45, "label": "Text", "bbox": {"x1": 81, "y1": 1084, "x2": 670, "y2": 1102}, "content": "đại diện của cá nhân tôi, những người thừa kế và/ hoặc quản lý di sản của tôi.", "kind": "note", "text": "đại diện của cá nhân tôi, những người thừa kế và/ hoặc quản lý di sản của tôi.", "quad": [[80.9, 1084.0], [670.1, 1084.0], [670.1, 1101.6], [80.9, 1101.6]]}, {"id": "p1-b46", "page_number": 1, "index_in_page": 46, "label": "Text", "bbox": {"x1": 78, "y1": 1131, "x2": 237, "y2": 1149}, "content": "Bên mua bảo hiểm", "kind": "sign.title", "text": "Bên mua bảo hiểm", "quad": [[78.3, 1131.3], [236.6, 1131.3], [2