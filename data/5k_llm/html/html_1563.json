 yêu cầu, khiếu nại, nghĩa ", "quad": [[107.9, 1054.6], [1050.2, 1054.6], [1050.2, 1073.3], [107.9, 1073.3]]}, {"id": "p1-b42", "page_number": 1, "index_in_page": 42, "label": "Text", "bbox": {"x1": 108, "y1": 1078, "x2": 1025, "y2": 1096}, "content": "vụ nợ, tổn thất, chi phí phát sinh liên quan đến hay do việc Công ty thanh toán khoản tiền này cho Người được ủy", "kind": "note", "text": "vụ nợ, tổn thất, chi phí phát sinh liên quan đến hay do việc Công ty thanh toán khoản tiền này cho Người được ủy ", "quad": [[107.9, 1077.5], [1024.8, 1077.5], [1024.8, 1096.2], [107.9, 1096.2]]}, {"id": "p1-b43", "page_number": 1, "index_in_page": 43, "label": "Text", "bbox": {"x1": 108, "y1": 1100, "x2": 236, "y2": 1119}, "content": "quyền nêu trên.", "kind": "note", "text": "quyền nêu trên.", "quad": [[107.9, 1100.3], [236.3, 1100.3], [236.3, 1119.0], [107.9, 1119.0]]}, {"id": "p1-b44", "page_number": 1, "index_in_page": 44, "label": "Text", "bbox": {"x1": 86, "y1": 1132, "x2": 1032, "y2": 1151}, "content": "Giấy ủy quyền này chỉ có hiệu lực trong vòng ba (03) tháng kể từ ngày ký và có giá trị ràng buộc đối với những người", "kind": "note", "text": "Giấy ủy quyền này chỉ có hiệu lực trong vòng ba (03) tháng kể từ ngày ký và có giá trị ràng buộc đối với những người ", "quad": [[86.2, 1131.9], [1031.9, 1131.9], [1031.9, 1150.6], [86.2, 1150.6]]}, {"id": "p1-b45", "page_number": 1, "index_in_page": 45, "label": "Text", "bbox": {"x1": 86, "y1": 1155, "x2": 714, "y2": 1174}, "content": "đại diện của cá nhân tôi, những người thừa kế và/ hoặc quản lý di sản của tôi.", "kind": "note", "text": "đại diện của cá nhân tôi, những người thừa kế và/ hoặc quản lý di sản của tôi.", "quad": [[86.2, 1154.8], [713.8, 1154.8], [713.8, 1173.5], [86.2, 1173.5]]}, {"id": "p1-b46", "page_number": 1, "index_in_page": 46, "label": "Text", "bbox": {"x1": 83, "y1": 1205, "x2": 252, "y2": 1224}, "content": "Bên mua bảo hiểm", "kind": "sign.title", "text": "Bên mua bảo hiểm", "quad": [[83.4, 1205.2], [252.1,