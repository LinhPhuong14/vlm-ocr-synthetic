ả bất kỳ khoản tiền gì đối với tất cả các yêu cầu, khiếu nại, nghĩa ", "quad": [[122.0, 1192.2], [1187.2, 1192.2], [1187.2, 1213.3], [122.0, 1213.3]]}, {"id": "p1-b42", "page_number": 1, "index_in_page": 42, "label": "Text", "bbox": {"x1": 122, "y1": 1218, "x2": 1158, "y2": 1239}, "content": "vụ nợ, tổn thất, chi phí phát sinh liên quan đến hay do việc Công ty thanh toán khoản tiền này cho Người được ủy", "kind": "note", "text": "vụ nợ, tổn thất, chi phí phát sinh liên quan đến hay do việc Công ty thanh toán khoản tiền này cho Người được ủy ", "quad": [[122.0, 1218.0], [1158.5, 1218.0], [1158.5, 1239.2], [122.0, 1239.2]]}, {"id": "p1-b43", "page_number": 1, "index_in_page": 43, "label": "Text", "bbox": {"x1": 122, "y1": 1244, "x2": 267, "y2": 1265}, "content": "quyền nêu trên.", "kind": "note", "text": "quyền nêu trên.", "quad": [[122.0, 1243.9], [267.1, 1243.9], [267.1, 1265.0], [122.0, 1265.0]]}, {"id": "p1-b44", "page_number": 1, "index_in_page": 44, "label": "Text", "bbox": {"x1": 98, "y1": 1280, "x2": 1167, "y2": 1301}, "content": "Giấy ủy quyền này chỉ có hiệu lực trong vòng ba (03) tháng kể từ ngày ký và có giá trị ràng buộc đối với những người", "kind": "note", "text": "Giấy ủy quyền này chỉ có hiệu lực trong vòng ba (03) tháng kể từ ngày ký và có giá trị ràng buộc đối với những người ", "quad": [[97.5, 1279.6], [1166.6, 1279.6], [1166.6, 1300.7], [97.5, 1300.7]]}, {"id": "p1-b45", "page_number": 1, "index_in_page": 45, "label": "Text", "bbox": {"x1": 98, "y1": 1306, "x2": 807, "y2": 1327}, "content": "đại diện của cá nhân tôi, những người thừa kế và/ hoặc quản lý di sản của tôi.", "kind": "note", "text": "đại diện của cá nhân tôi, những người thừa kế và/ hoặc quản lý di sản của tôi.", "quad": [[97.5, 1305.5], [807.0, 1305.5], [807.0, 1326.6], [97.5, 1326.6]]}, {"id": "p1-b46", "page_number": 1, "index_in_page": 46, "label": "Text", "bbox": {"x1": 94, "y1": 1362, "x2": 285, "y2": 1384}, "content": "Bên mua bảo hiểm", "kind": "sign.title", "text": "Bên mua bả