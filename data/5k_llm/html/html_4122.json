text": "2) Tôi bồi hoàn và giữ cho Công ty không phải chi trả bất kỳ khoản tiền gì đối với tất cả các yêu cầu, khiếu nại, nghĩa ", "quad": [[127.7, 1247.6], [1242.3, 1247.6], [1242.3, 1269.7], [127.7, 1269.7]]}, {"id": "p1-b42", "page_number": 1, "index_in_page": 42, "label": "Text", "bbox": {"x1": 128, "y1": 1275, "x2": 1212, "y2": 1297}, "content": "vụ nợ, tổn thất, chi phí phát sinh liên quan đến hay do việc Công ty thanh toán khoản tiền này cho Người được ủy", "kind": "note", "text": "vụ nợ, tổn thất, chi phí phát sinh liên quan đến hay do việc Công ty thanh toán khoản tiền này cho Người được ủy ", "quad": [[127.7, 1274.6], [1212.4, 1274.6], [1212.4, 1296.8], [127.7, 1296.8]]}, {"id": "p1-b43", "page_number": 1, "index_in_page": 43, "label": "Text", "bbox": {"x1": 128, "y1": 1302, "x2": 280, "y2": 1324}, "content": "quyền nêu trên.", "kind": "note", "text": "quyền nêu trên.", "quad": [[127.7, 1301.7], [279.5, 1301.7], [279.5, 1323.8], [127.7, 1323.8]]}, {"id": "p1-b44", "page_number": 1, "index_in_page": 44, "label": "Text", "bbox": {"x1": 102, "y1": 1339, "x2": 1221, "y2": 1361}, "content": "Giấy ủy quyền này chỉ có hiệu lực trong vòng ba (03) tháng kể từ ngày ký và có giá trị ràng buộc đối với những người", "kind": "note", "text": "Giấy ủy quyền này chỉ có hiệu lực trong vòng ba (03) tháng kể từ ngày ký và có giá trị ràng buộc đối với những người ", "quad": [[102.0, 1339.1], [1220.8, 1339.1], [1220.8, 1361.2], [102.0, 1361.2]]}, {"id": "p1-b45", "page_number": 1, "index_in_page": 45, "label": "Text", "bbox": {"x1": 102, "y1": 1366, "x2": 844, "y2": 1388}, "content": "đại diện của cá nhân tôi, những người thừa kế và/ hoặc quản lý di sản của tôi.", "kind": "note", "text": "đại diện của cá nhân tôi, những người thừa kế và/ hoặc quản lý di sản của tôi.", "quad": [[102.0, 1366.1], [844.5, 1366.1], [844.5, 1388.2], [102.0, 1388.2]]}, {"id": "p1-b46", "page_number": 1, "index_in_page": 46, "label": "Text", "bbox": {"x1": 99, "y1": 1426, "x2": 298, "y2": 1448}, "conte