g phải chi trả bất kỳ khoản tiền gì đối với tất cả các yêu cầu, khiếu nại, nghĩa ", "quad": [[118.5, 1158.0], [1153.1, 1158.0], [1153.1, 1178.5], [118.5, 1178.5]]}, {"id": "p1-b42", "page_number": 1, "index_in_page": 42, "label": "Text", "bbox": {"x1": 118, "y1": 1183, "x2": 1125, "y2": 1204}, "content": "vụ nợ, tổn thất, chi phí phát sinh liên quan đến hay do việc Công ty thanh toán khoản tiền này cho Người được ủy", "kind": "note", "text": "vụ nợ, tổn thất, chi phí phát sinh liên quan đến hay do việc Công ty thanh toán khoản tiền này cho Người được ủy ", "quad": [[118.5, 1183.1], [1125.3, 1183.1], [1125.3, 1203.7], [118.5, 1203.7]]}, {"id": "p1-b43", "page_number": 1, "index_in_page": 43, "label": "Text", "bbox": {"x1": 118, "y1": 1208, "x2": 260, "y2": 1229}, "content": "quyền nêu trên.", "kind": "note", "text": "quyền nêu trên.", "quad": [[118.5, 1208.2], [259.5, 1208.2], [259.5, 1228.8], [118.5, 1228.8]]}, {"id": "p1-b44", "page_number": 1, "index_in_page": 44, "label": "Text", "bbox": {"x1": 95, "y1": 1243, "x2": 1133, "y2": 1264}, "content": "Giấy ủy quyền này chỉ có hiệu lực trong vòng ba (03) tháng kể từ ngày ký và có giá trị ràng buộc đối với những người", "kind": "note", "text": "Giấy ủy quyền này chỉ có hiệu lực trong vòng ba (03) tháng kể từ ngày ký và có giá trị ràng buộc đối với những người ", "quad": [[94.7, 1242.9], [1133.1, 1242.9], [1133.1, 1263.5], [94.7, 1263.5]]}, {"id": "p1-b45", "page_number": 1, "index_in_page": 45, "label": "Text", "bbox": {"x1": 95, "y1": 1268, "x2": 784, "y2": 1289}, "content": "đại diện của cá nhân tôi, những người thừa kế và/ hoặc quản lý di sản của tôi.", "kind": "note", "text": "đại diện của cá nhân tôi, những người thừa kế và/ hoặc quản lý di sản của tôi.", "quad": [[94.7, 1268.0], [783.8, 1268.0], [783.8, 1288.6], [94.7, 1288.6]]}, {"id": "p1-b46", "page_number": 1, "index_in_page": 46, "label": "Text", "bbox": {"x1": 92, "y1": 1323, "x2": 277, "y2": 1344}, "content": "Bên mua bảo hiểm", "kind": "sign.title", "text"