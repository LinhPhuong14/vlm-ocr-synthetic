te", "text": "2) Tôi bồi hoàn và giữ cho Công ty không phải chi trả bất kỳ khoản tiền gì đối với tất cả các yêu cầu, khiếu nại, nghĩa ", "quad": [[131.4, 1283.6], [1278.2, 1283.6], [1278.2, 1306.4], [131.4, 1306.4]]}, {"id": "p1-b42", "page_number": 1, "index_in_page": 42, "label": "Text", "bbox": {"x1": 131, "y1": 1311, "x2": 1247, "y2": 1334}, "content": "vụ nợ, tổn thất, chi phí phát sinh liên quan đến hay do việc Công ty thanh toán khoản tiền này cho Người được ủy", "kind": "note", "text": "vụ nợ, tổn thất, chi phí phát sinh liên quan đến hay do việc Công ty thanh toán khoản tiền này cho Người được ủy ", "quad": [[131.4, 1311.4], [1247.4, 1311.4], [1247.4, 1334.2], [131.4, 1334.2]]}, {"id": "p1-b43", "page_number": 1, "index_in_page": 43, "label": "Text", "bbox": {"x1": 131, "y1": 1339, "x2": 288, "y2": 1362}, "content": "quyền nêu trên.", "kind": "note", "text": "quyền nêu trên.", "quad": [[131.4, 1339.3], [287.6, 1339.3], [287.6, 1362.0], [131.4, 1362.0]]}, {"id": "p1-b44", "page_number": 1, "index_in_page": 44, "label": "Text", "bbox": {"x1": 105, "y1": 1378, "x2": 1256, "y2": 1400}, "content": "Giấy ủy quyền này chỉ có hiệu lực trong vòng ba (03) tháng kể từ ngày ký và có giá trị ràng buộc đối với những người", "kind": "note", "text": "Giấy ủy quyền này chỉ có hiệu lực trong vòng ba (03) tháng kể từ ngày ký và có giá trị ràng buộc đối với những người ", "quad": [[104.9, 1377.7], [1256.0, 1377.7], [1256.0, 1400.5], [104.9, 1400.5]]}, {"id": "p1-b45", "page_number": 1, "index_in_page": 45, "label": "Text", "bbox": {"x1": 105, "y1": 1406, "x2": 869, "y2": 1428}, "content": "đại diện của cá nhân tôi, những người thừa kế và/ hoặc quản lý di sản của tôi.", "kind": "note", "text": "đại diện của cá nhân tôi, những người thừa kế và/ hoặc quản lý di sản của tôi.", "quad": [[104.9, 1405.6], [868.8, 1405.6], [868.8, 1428.3], [104.9, 1428.3]]}, {"id": "p1-b46", "page_number": 1, "index_in_page": 46, "label": "Text", "bbox": {"x1": 102, "y1": 1467, "x2": 307, "y2": 1490},