i tất cả các yêu cầu, khiếu nại, nghĩa ", "quad": [[93.6, 914.2], [910.4, 914.2], [910.4, 930.4], [93.6, 930.4]]}, {"id": "p1-b42", "page_number": 1, "index_in_page": 42, "label": "Text", "bbox": {"x1": 94, "y1": 934, "x2": 888, "y2": 950}, "content": "vụ nợ, tổn thất, chi phí phát sinh liên quan đến hay do việc Công ty thanh toán khoản tiền này cho Người được ủy", "kind": "note", "text": "vụ nợ, tổn thất, chi phí phát sinh liên quan đến hay do việc Công ty thanh toán khoản tiền này cho Người được ủy ", "quad": [[93.6, 934.0], [888.4, 934.0], [888.4, 950.3], [93.6, 950.3]]}, {"id": "p1-b43", "page_number": 1, "index_in_page": 43, "label": "Text", "bbox": {"x1": 94, "y1": 954, "x2": 205, "y2": 970}, "content": "quyền nêu trên.", "kind": "note", "text": "quyền nêu trên.", "quad": [[93.6, 953.9], [204.8, 953.9], [204.8, 970.1], [93.6, 970.1]]}, {"id": "p1-b44", "page_number": 1, "index_in_page": 44, "label": "Text", "bbox": {"x1": 75, "y1": 981, "x2": 895, "y2": 998}, "content": "Giấy ủy quyền này chỉ có hiệu lực trong vòng ba (03) tháng kể từ ngày ký và có giá trị ràng buộc đối với những người", "kind": "note", "text": "Giấy ủy quyền này chỉ có hiệu lực trong vòng ba (03) tháng kể từ ngày ký và có giá trị ràng buộc đối với những người ", "quad": [[74.7, 981.3], [894.6, 981.3], [894.6, 997.5], [74.7, 997.5]]}, {"id": "p1-b45", "page_number": 1, "index_in_page": 45, "label": "Text", "bbox": {"x1": 75, "y1": 1001, "x2": 619, "y2": 1017}, "content": "đại diện của cá nhân tôi, những người thừa kế và/ hoặc quản lý di sản của tôi.", "kind": "note", "text": "đại diện của cá nhân tôi, những người thừa kế và/ hoặc quản lý di sản của tôi.", "quad": [[74.7, 1001.1], [618.8, 1001.1], [618.8, 1017.3], [74.7, 1017.3]]}, {"id": "p1-b46", "page_number": 1, "index_in_page": 46, "label": "Text", "bbox": {"x1": 72, "y1": 1045, "x2": 218, "y2": 1061}, "content": "Bên mua bảo hiểm", "kind": "sign.title", "text": "Bên mua bảo hiểm", "quad": [[72.3, 1044.8], [218.5, 1044.8], [218.5, 1061.0],