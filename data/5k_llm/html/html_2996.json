hoản tiền gì đối với tất cả các yêu cầu, khiếu nại, nghĩa ", "quad": [[117.7, 1149.7], [1144.9, 1149.7], [1144.9, 1170.1], [117.7, 1170.1]]}, {"id": "p1-b42", "page_number": 1, "index_in_page": 42, "label": "Text", "bbox": {"x1": 118, "y1": 1175, "x2": 1117, "y2": 1195}, "content": "vụ nợ, tổn thất, chi phí phát sinh liên quan đến hay do việc Công ty thanh toán khoản tiền này cho Người được ủy", "kind": "note", "text": "vụ nợ, tổn thất, chi phí phát sinh liên quan đến hay do việc Công ty thanh toán khoản tiền này cho Người được ủy ", "quad": [[117.7, 1174.6], [1117.3, 1174.6], [1117.3, 1195.0], [117.7, 1195.0]]}, {"id": "p1-b43", "page_number": 1, "index_in_page": 43, "label": "Text", "bbox": {"x1": 118, "y1": 1200, "x2": 258, "y2": 1220}, "content": "quyền nêu trên.", "kind": "note", "text": "quyền nêu trên.", "quad": [[117.7, 1199.6], [257.6, 1199.6], [257.6, 1220.0], [117.7, 1220.0]]}, {"id": "p1-b44", "page_number": 1, "index_in_page": 44, "label": "Text", "bbox": {"x1": 94, "y1": 1234, "x2": 1125, "y2": 1254}, "content": "Giấy ủy quyền này chỉ có hiệu lực trong vòng ba (03) tháng kể từ ngày ký và có giá trị ràng buộc đối với những người", "kind": "note", "text": "Giấy ủy quyền này chỉ có hiệu lực trong vòng ba (03) tháng kể từ ngày ký và có giá trị ràng buộc đối với những người ", "quad": [[94.0, 1234.0], [1125.0, 1234.0], [1125.0, 1254.4], [94.0, 1254.4]]}, {"id": "p1-b45", "page_number": 1, "index_in_page": 45, "label": "Text", "bbox": {"x1": 94, "y1": 1259, "x2": 778, "y2": 1279}, "content": "đại diện của cá nhân tôi, những người thừa kế và/ hoặc quản lý di sản của tôi.", "kind": "note", "text": "đại diện của cá nhân tôi, những người thừa kế và/ hoặc quản lý di sản của tôi.", "quad": [[94.0, 1258.9], [778.2, 1258.9], [778.2, 1279.3], [94.0, 1279.3]]}, {"id": "p1-b46", "page_number": 1, "index_in_page": 46, "label": "Text", "bbox": {"x1": 91, "y1": 1314, "x2": 275, "y2": 1334}, "content": "Bên mua bảo hiểm", "kind": "sign.title", "text": "Bên mua bảo hiểm", "