t cả các yêu cầu, khiếu nại, nghĩa ", "quad": [[103.9, 1014.9], [1010.6, 1014.9], [1010.6, 1032.9], [103.9, 1032.9]]}, {"id": "p1-b42", "page_number": 1, "index_in_page": 42, "label": "Text", "bbox": {"x1": 104, "y1": 1037, "x2": 986, "y2": 1055}, "content": "vụ nợ, tổn thất, chi phí phát sinh liên quan đến hay do việc Công ty thanh toán khoản tiền này cho Người được ủy", "kind": "note", "text": "vụ nợ, tổn thất, chi phí phát sinh liên quan đến hay do việc Công ty thanh toán khoản tiền này cho Người được ủy ", "quad": [[103.9, 1036.9], [986.2, 1036.9], [986.2, 1054.9], [103.9, 1054.9]]}, {"id": "p1-b43", "page_number": 1, "index_in_page": 43, "label": "Text", "bbox": {"x1": 104, "y1": 1059, "x2": 227, "y2": 1077}, "content": "quyền nêu trên.", "kind": "note", "text": "quyền nêu trên.", "quad": [[103.9, 1058.9], [227.4, 1058.9], [227.4, 1076.9], [103.9, 1076.9]]}, {"id": "p1-b44", "page_number": 1, "index_in_page": 44, "label": "Text", "bbox": {"x1": 83, "y1": 1089, "x2": 993, "y2": 1107}, "content": "Giấy ủy quyền này chỉ có hiệu lực trong vòng ba (03) tháng kể từ ngày ký và có giá trị ràng buộc đối với những người", "kind": "note", "text": "Giấy ủy quyền này chỉ có hiệu lực trong vòng ba (03) tháng kể từ ngày ký và có giá trị ràng buộc đối với những người ", "quad": [[83.0, 1089.3], [993.1, 1089.3], [993.1, 1107.3], [83.0, 1107.3]]}, {"id": "p1-b45", "page_number": 1, "index_in_page": 45, "label": "Text", "bbox": {"x1": 83, "y1": 1111, "x2": 687, "y2": 1129}, "content": "đại diện của cá nhân tôi, những người thừa kế và/ hoặc quản lý di sản của tôi.", "kind": "note", "text": "đại diện của cá nhân tôi, những người thừa kế và/ hoặc quản lý di sản của tôi.", "quad": [[83.0, 1111.3], [686.9, 1111.3], [686.9, 1129.3], [83.0, 1129.3]]}, {"id": "p1-b46", "page_number": 1, "index_in_page": 46, "label": "Text", "bbox": {"x1": 80, "y1": 1160, "x2": 243, "y2": 1178}, "content": "Bên mua bảo hiểm", "kind": "sign.title", "text": "Bên mua bảo hiểm", "quad": [[80.3, 1159.8], [242.