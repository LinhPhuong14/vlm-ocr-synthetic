 944.7], [940.7, 961.4], [96.7, 961.4]]}, {"id": "p1-b42", "page_number": 1, "index_in_page": 42, "label": "Text", "bbox": {"x1": 97, "y1": 965, "x2": 918, "y2": 982}, "content": "vụ nợ, tổn thất, chi phí phát sinh liên quan đến hay do việc Công ty thanh toán khoản tiền này cho Người được ủy", "kind": "note", "text": "vụ nợ, tổn thất, chi phí phát sinh liên quan đến hay do việc Công ty thanh toán khoản tiền này cho Người được ủy ", "quad": [[96.7, 965.2], [918.0, 965.2], [918.0, 981.9], [96.7, 981.9]]}, {"id": "p1-b43", "page_number": 1, "index_in_page": 43, "label": "Text", "bbox": {"x1": 97, "y1": 986, "x2": 212, "y2": 1002}, "content": "quyền nêu trên.", "kind": "note", "text": "quyền nêu trên.", "quad": [[96.7, 985.7], [211.7, 985.7], [211.7, 1002.4], [96.7, 1002.4]]}, {"id": "p1-b44", "page_number": 1, "index_in_page": 44, "label": "Text", "bbox": {"x1": 77, "y1": 1014, "x2": 924, "y2": 1031}, "content": "Giấy ủy quyền này chỉ có hiệu lực trong vòng ba (03) tháng kể từ ngày ký và có giá trị ràng buộc đối với những người", "kind": "note", "text": "Giấy ủy quyền này chỉ có hiệu lực trong vòng ba (03) tháng kể từ ngày ký và có giá trị ràng buộc đối với những người ", "quad": [[77.2, 1014.0], [924.4, 1014.0], [924.4, 1030.7], [77.2, 1030.7]]}, {"id": "p1-b45", "page_number": 1, "index_in_page": 45, "label": "Text", "bbox": {"x1": 77, "y1": 1034, "x2": 639, "y2": 1051}, "content": "đại diện của cá nhân tôi, những người thừa kế và/ hoặc quản lý di sản của tôi.", "kind": "note", "text": "đại diện của cá nhân tôi, những người thừa kế và/ hoặc quản lý di sản của tôi.", "quad": [[77.2, 1034.5], [639.4, 1034.5], [639.4, 1051.2], [77.2, 1051.2]]}, {"id": "p1-b46", "page_number": 1, "index_in_page": 46, "label": "Text", "bbox": {"x1": 75, "y1": 1080, "x2": 226, "y2": 1096}, "content": "Bên mua bảo hiểm", "kind": "sign.title", "text": "Bên mua bảo hiểm", "quad": [[74.7, 1079.6], [225.8, 1079.6], [225.8, 1096.3], [74.7, 1096.3]]}, {"id": "p1-b47", "page_number": 1, "index_in_