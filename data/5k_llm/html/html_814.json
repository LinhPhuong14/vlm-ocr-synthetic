d": "note", "text": "2) Tôi bồi hoàn và giữ cho Công ty không phải chi trả bất kỳ khoản tiền gì đối với tất cả các yêu cầu, khiếu nại, nghĩa ", "quad": [[127.0, 1241.1], [1235.9, 1241.1], [1235.9, 1263.1], [127.0, 1263.1]]}, {"id": "p1-b42", "page_number": 1, "index_in_page": 42, "label": "Text", "bbox": {"x1": 127, "y1": 1268, "x2": 1206, "y2": 1290}, "content": "vụ nợ, tổn thất, chi phí phát sinh liên quan đến hay do việc Công ty thanh toán khoản tiền này cho Người được ủy", "kind": "note", "text": "vụ nợ, tổn thất, chi phí phát sinh liên quan đến hay do việc Công ty thanh toán khoản tiền này cho Người được ủy ", "quad": [[127.0, 1268.0], [1206.1, 1268.0], [1206.1, 1290.0], [127.0, 1290.0]]}, {"id": "p1-b43", "page_number": 1, "index_in_page": 43, "label": "Text", "bbox": {"x1": 127, "y1": 1295, "x2": 278, "y2": 1317}, "content": "quyền nêu trên.", "kind": "note", "text": "quyền nêu trên.", "quad": [[127.0, 1295.0], [278.1, 1295.0], [278.1, 1317.0], [127.0, 1317.0]]}, {"id": "p1-b44", "page_number": 1, "index_in_page": 44, "label": "Text", "bbox": {"x1": 102, "y1": 1332, "x2": 1214, "y2": 1354}, "content": "Giấy ủy quyền này chỉ có hiệu lực trong vòng ba (03) tháng kể từ ngày ký và có giá trị ràng buộc đối với những người", "kind": "note", "text": "Giấy ủy quyền này chỉ có hiệu lực trong vòng ba (03) tháng kể từ ngày ký và có giá trị ràng buộc đối với những người ", "quad": [[101.5, 1332.1], [1214.5, 1332.1], [1214.5, 1354.1], [101.5, 1354.1]]}, {"id": "p1-b45", "page_number": 1, "index_in_page": 45, "label": "Text", "bbox": {"x1": 102, "y1": 1359, "x2": 840, "y2": 1381}, "content": "đại diện của cá nhân tôi, những người thừa kế và/ hoặc quản lý di sản của tôi.", "kind": "note", "text": "đại diện của cá nhân tôi, những người thừa kế và/ hoặc quản lý di sản của tôi.", "quad": [[101.5, 1359.0], [840.1, 1359.0], [840.1, 1381.1], [101.5, 1381.1]]}, {"id": "p1-b46", "page_number": 1, "index_in_page": 46, "label": "Text", "bbox": {"x1": 98, "y1": 1418, "x2": 297, "y2": 